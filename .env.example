# API REST del microservicio de Despachos (vía API Gateway del ERP)
VITE_API_URL=http://localhost:3001/api

# Gateway de WebSocket para el tablero en tiempo real (RF-A06, RNF < 3s)
# Si se omite, se deriva de VITE_API_URL
VITE_WS_URL=http://localhost:3001

# URL pública del portal (para armar los enlaces de seguimiento, RF-U14)
VITE_SITE_URL=http://localhost:3000
