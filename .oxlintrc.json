{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["react", "typescript", "oxc", "import"],
  "rules": {
    "react/rules-of-hooks": "error",
    "react/only-export-components": ["warn", { "allowConstantExport": true }],
    "no-console": ["warn", { "allow": ["warn", "error"] }],
    "no-restricted-imports": [
      "error",
      {
        "patterns": [
          {
            "group": ["@/domains/*/**"],
            "message": "Importa desde el barrel del dominio: @/domains/<dominio>"
          },
          {
            "group": ["@/pages/**"],
            "message": "Nada puede importar de pages/. Las dependencias van pages → domains → shared."
          }
        ]
      }
    ]
  },
  "overrides": [
    {
      "files": ["src/app/router.tsx", "src/app/page-routes.ts"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [{
              "group": ["@/domains/*/**"],
              "message": "Importa desde el barrel del dominio: @/domains/<dominio>"
            }]
          }
        ]
      }
    },
    {
      "files": ["src/shared/**/*", "src/config/**/*"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [{
              "group": ["@/app/**", "@/domains/**", "@/pages/**", "**/app/**", "**/domains/**", "**/pages/**"],
              "message": "shared/ y config/ no pueden depender de app/, domains/ ni pages/."
            }]
          }
        ]
      }
    },
    {
      "files": ["src/domains/**/*"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [{
              "group": ["@/app/**", "@/pages/**", "@/domains/*/**", "**/app/**", "**/pages/**", "**/domains/*/**"],
              "message": "domains/ depende de shared/ y config/; usa el barrel de otros dominios."
            }]
          }
        ]
      }
    },
    {
      "files": ["src/pages/**/*"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [{
              "group": ["@/app/**", "@/pages/**", "@/domains/*/**", "**/app/**", "**/pages/**", "**/domains/*/**"],
              "message": "pages/ puede depender de dominios públicos, shared/ y config/, no de app/ ni de archivos internos."
            }]
          }
        ]
      }
    }
  ]
}
