{
  "name": "delivery-dispatch-web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint --deny-warnings",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "test:session": "node --test scripts/session-lifecycle.test.mjs",
    "test:errors": "node --test scripts/error-handling.test.mjs",
    "test:password-change": "node --test scripts/required-password-change.test.mjs",
    "test:loading": "node --test scripts/loading-states.test.mjs",
    "test:configuration": "node --test scripts/app-configuration.test.mjs",
    "test:catalog-patterns": "node --test scripts/catalog-patterns.test.mjs",
    "test:architecture": "node --test scripts/architecture.test.mjs",
    "test:bandeja-pedidos": "node --test scripts/bandeja-pedidos.test.mjs",
    "test:parametros-operativos": "node --test scripts/parametros-operativos.test.mjs",
    "test:prioridad-filtros": "node --test scripts/prioridad-filtros.test.mjs",
    "test:seguimiento-publico": "node --test scripts/seguimiento-publico.test.mjs",
    "test:lote-provisional": "node --test scripts/lote-provisional.test.mjs",
    "test:kanban": "vitest run scripts/tablero-kanban.test.tsx scripts/tablero-sync.test.tsx",
    "test:ficha-despacho": "vitest run scripts/despacho-ficha.test.tsx",
    "test:reprogramacion": "vitest run scripts/reprogramacion-despacho.test.tsx",
    "test:historial": "vitest run scripts/historial-despachos.test.tsx",
    "test:solicitudes": "vitest run scripts/solicitudes-cambio.test.tsx",
    "test:navegacion-rol": "vitest run scripts/navegacion-rol.test.tsx",
